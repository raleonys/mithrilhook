1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x17L
#ifdef _DEBUG
 FILEFLAGS (0x1L | @MITHRILHOOK_RESOURCE_FLAGS@L)
#else
 FILEFLAGS @MITHRILHOOK_RESOURCE_FLAGS@L
#endif
 FILEOS 0x4L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MithrilHook contributors"
            VALUE "FileDescription", "MithrilHook - checked Windows function hooks"
            VALUE "FileVersion", "@MITHRILHOOK_VERSION@"
            VALUE "InternalName", "mithrilhook"
            VALUE "LegalCopyright", "MinHook: Tsuda Kageyu; SAFE-FREEZE: Brownfield contributors; MithrilHook contributors. See distributed licenses."
            VALUE "ProductName", "MithrilHook"
            VALUE "ProductVersion", "@MITHRILHOOK_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
